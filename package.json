{
  "name": "ros-ikuai-monitor-panel-framework",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prebuild": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit",
    "build": "node --max-old-space-size=2048 tools/build-framework-inline.mjs",
    "check:types": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit",
    "check:overview": "node --max-old-space-size=2048 tools/format-overview-css.js --check && node --max-old-space-size=2048 tools/check-overview-architecture.js && node --max-old-space-size=2048 tools/check-overview-ikuai-static.js",
    "check:overview-architecture": "node --max-old-space-size=2048 tools/check-overview-architecture.js",
    "check:runtime-schema": "node --max-old-space-size=2048 tools/check-panel-runtime-schema.js",
    "check:runtime-browser": "node --max-old-space-size=2048 tools/check-panel-runtime-browser.js",
    "check:sections": "node --max-old-space-size=2048 tools/check-section-models.js",
    "check:backend-security": "python tools/check-backend-security.py",
    "check:mobile-native-model": "node --max-old-space-size=2048 tools/check-mobile-native-model.js",
    "check:mobile-native": "node --max-old-space-size=2048 tools/check-mobile-native-model.js && node --max-old-space-size=2048 tools/check-mobile-native-runtime.js",
    "check:desktop-no-snapshot": "node --max-old-space-size=2048 tools/check-desktop-no-snapshot-runtime.js",
    "check:desktop-v1030": "node --max-old-space-size=2048 tools/check-desktop-v1030-runtime.js",
    "check:desktop-incident-hierarchy": "node --max-old-space-size=2048 tools/check-desktop-incident-hierarchy-runtime.js"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
