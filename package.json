{
  "name": "ros-ikuai-monitor-panel-framework",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prebuild": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit",
    "build": "node --max-old-space-size=2048 tools/build-framework-inline.mjs",
    "check:types": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit",
    "check:overview": "node --max-old-space-size=2048 tools/format-overview-css.js --check && node --max-old-space-size=2048 tools/check-overview-architecture.js && node --max-old-space-size=2048 tools/check-overview-ikuai-static.js",
    "check:overview-architecture": "node --max-old-space-size=2048 tools/check-overview-architecture.js",
    "check:mobile-app-home": "node --max-old-space-size=2048 tools/check-mobile-app-home-runtime.js",
    "check:desktop-no-snapshot": "node --max-old-space-size=2048 tools/check-desktop-no-snapshot-runtime.js",
    "check:desktop-v1030": "node --max-old-space-size=2048 tools/check-desktop-v1030-runtime.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
