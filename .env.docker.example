# Copy to .env.docker for local Docker runs, or pass with:
# docker compose --env-file .env.docker up -d --build

# Public default: only the Docker host itself can open the panel at
# http://127.0.0.1:28646/. Other IP browser entrypoints are not enabled by
# the public Docker defaults. Do not replace this with the host LAN IP unless
# you also provide a reviewed authenticated remote-access design.
ROS_PANEL_CONTAINER_NAME=routeros-triage-panel
ROS_PANEL_IMAGE=routeros-triage-panel:local
# Optional prebuilt image, usable after the GHCR package visibility is public:
# ROS_PANEL_IMAGE=ghcr.io/cullysu/ros-ikuai-monitor-panel:main
ROS_PANEL_PUBLISHED_ADDR=127.0.0.1
ROS_PANEL_PUBLISHED_PORT=28646

# The in-container app must bind all interfaces so Docker can publish it.
ROS_PANEL_BIND=0.0.0.0
ROS_PANEL_PORT=28646
# Browser-facing fallback shown by startup logs and config pages. API responses
# prefer the HTTP Host header, so normal browser access works with the URL the
# user actually opened. The default fallback stays localhost.
ROS_PANEL_TARGET_IP=127.0.0.1
# Honor X-Forwarded-* URL headers only behind a trusted reverse proxy.
ROS_PANEL_TRUST_PROXY_HEADERS=0
# Keep direct non-loopback peers rejected. RouterOS Container docs enable this
# separately with a random token injected by the client-local forwarder helper.
ROS_PANEL_ALLOW_LOCALHOST_HOST_FORWARD=0
ROS_PANEL_LOCALHOST_FORWARD_TOKEN=
ROS_PANEL_PROFILE=routeros_only

# RouterOS read-only login defaults. Do not use admin.
# First-run public installs can leave these placeholders and enter the real
# RouterOS SSH login in the panel UI instead.
ROS_MONITOR_ROUTER_HOST=192.168.88.1
ROS_MONITOR_ROUTER_USER=ros-panel-readonly
ROS_MONITOR_ROUTER_PASSWORD=CHANGE_ME
ROS_MONITOR_ROUTER_REST_SCHEME=https
ROS_MONITOR_ROUTER_REST_PORT=443
ROS_MONITOR_ROUTER_REST_VERIFY_TLS=1
ROS_MONITOR_INSECURE_REST_CONFIRMED=0
# Leave blank for the first-use SSH fingerprint confirmation in the panel UI.
ROS_MONITOR_SSH_HOST_KEY_FINGERPRINT=
ROS_PANEL_SESSION_TTL_SECONDS=28800
ROS_PANEL_SESSION_MAX=128
ROS_PANEL_SESSION_BOOTSTRAP_LIMIT=30
ROS_PANEL_LOGIN_ATTEMPT_LIMIT=8
ROS_PANEL_RATE_LIMIT_WINDOW_SECONDS=60

# Public/read-only guardrails.
ROS_PANEL_IP_ALIAS_WRITE_ENABLED=0
ROS_PANEL_EXPOSE_ADMIN_SESSIONS=0
ROS_PANEL_LOCAL_SETTINGS_WRITE_ENABLED=0
ROS_PANEL_ACTION_QUEUE_LIMIT=24
# Optional private diagnostics. Leave blank for public RouterOS-only installs.
ROS_PANEL_READONLY_DNS_SERVERS=
ROS_PANEL_READONLY_OPENWRT_DNS=
ROS_PANEL_READONLY_NIKKI_CONTROLLER=

# Polling defaults. Increase these on small RouterOS devices if needed.
ROS_MONITOR_POLL_SECONDS=1
ROS_MONITOR_STATIC_POLL_SECONDS=300
ROS_MONITOR_STATIC_REST_WORKERS=1
ROS_MONITOR_SLOW_REST_POLL_SECONDS=60
ROS_MONITOR_SLOW_REST_WORKERS=2
ROS_MONITOR_CONNECTION_DETAIL_POLL_SECONDS=4
ROS_MONITOR_DETAIL_REST_WORKERS=1
ROS_MONITOR_CONNECTION_PROTOCOL_POLL_SECONDS=30
